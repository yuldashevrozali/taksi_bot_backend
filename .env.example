# MongoDB Atlas. Database name goes in the path (here: "taxi").
# Atlas -> Database -> Connect -> Drivers -> copy the mongodb+srv URI.
DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/taxi?retryWrites=true&w=majority"

# Telegram
BOT_TOKEN=""
# Random 16-256 chars [A-Za-z0-9_-]. Generate: node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
BOT_WEBHOOK_SECRET=""
DRIVERS_GROUP_CHAT_ID=""
# Comma-separated Telegram IDs that are bootstrapped as admins
ADMIN_TELEGRAM_IDS=""

# App
API_PORT=3000
# Public HTTPS URL (Mini App + webhook). In dev, `npm run tunnel` fills it in .env automatically.
PUBLIC_BASE_URL="https://example.com"
# Signs admin browser sessions (random, 32+ chars)
SESSION_SECRET=""

# Optional: Mini App short name from @BotFather (/newapp). Makes the drivers-group button open the app directly.
MINI_APP_SHORT_NAME=""

# Optional: Mini App hosted separately (Vercel), e.g. https://taxi-miniapp.vercel.app
# Bot buttons open it and the API allows CORS from it. Empty = served by this backend at /app/.
MINI_APP_URL=""
